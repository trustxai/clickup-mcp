# ClickUp MCP server configuration.
# Copy to .env and fill in. NEVER commit .env.

# Personal API token (ClickUp → Settings → Apps → API Token, starts with pk_)
# or an OAuth2 access token. Sent verbatim in the Authorization header.
CLICKUP_API_TOKEN=

# Default Workspace (team) id. Optional — tools that need it also accept it as a
# parameter; setting it here lets you omit it in calls.
# CLICKUP_TEAM_ID=

# API base URLs. Only override for testing/proxies.
# CLICKUP_API_URL=https://api.clickup.com/api/v2
# CLICKUP_API_URL_V3=https://api.clickup.com/api/v3

# Per-request timeout in seconds.
# CLICKUP_REQUEST_TIMEOUT_SECONDS=30

# Set to 1 to allow the destructive live test suite (creates/deletes real objects).
# CLICKUP_TEST_ALLOW_DESTRUCTIVE=
